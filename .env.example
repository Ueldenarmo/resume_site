# Core app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAYLOAD_SECRET=replace-with-long-secret

# Database (Supabase Postgres recommended for production)
# Set at least one of these two variables.
SUPABASE_DATABASE_URI=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URI=postgres://postgres:postgres@localhost:5432/portfolio_kisik

# Payload revalidate endpoint protection
REVALIDATE_SECRET=replace-with-revalidate-secret

# Payload Vercel Blob storage (free tier friendly)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Optional feature flags
ENABLE_DRAFT_PREVIEW=true
